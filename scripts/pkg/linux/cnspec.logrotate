# Rotates the cnspec service log. The service writes it only when log_file is
# set in /etc/opt/mondoo/mondoo.yml; a log_file outside /var/log/cnspec needs
# its own rule.
#
# copytruncate: the service holds the file open for its whole life and does
# not reopen it on a signal. It opens the file with O_APPEND, so truncating in
# place is safe; lines written during the copy can be lost.
/var/log/cnspec/*.log {
    weekly
    maxsize 100M
    rotate 4
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
}
